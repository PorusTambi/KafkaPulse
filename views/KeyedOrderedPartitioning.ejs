<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Kafka Pulse: Key-Based Partitioning</title>
  <style>
    body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background: #f4f7f6; color: #333; padding: 20px; max-width: 1000px; margin: 0 auto; }
    h1, h2 { color: #2c3e50; }
    
    /* Concept Summary Block */
    .summary { background: #e8f4f8; border-left: 5px solid #3498db; padding: 15px 20px; border-radius: 5px; margin-bottom: 30px; }
    .summary ul { margin: 10px 0 0 0; padding-left: 20px; }
    .summary li { margin-bottom: 8px; line-height: 1.5; }

    /* Layout Grids */
    .row { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 30px; }
    
    /* Box Styles */
    .box { background: white; padding: 20px; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.05); }
    .box h3 { margin-top: 0; text-align: center; color: #34495e; border-bottom: 2px solid #ecf0f1; padding-bottom: 10px; }
    
    /* Messages & Highlights */
    .msg { background: #f9f9f9; border: 1px solid #ddd; padding: 10px; margin-bottom: 10px; border-radius: 5px; font-size: 14px; }
    .msg.highlight { background: #fff3cd; border-color: #ffeeba; border-left: 4px solid #ffc107; }
    
    /* UI Elements */
    button { background: #3498db; color: white; border: none; padding: 10px 20px; font-size: 16px; border-radius: 5px; cursor: pointer; transition: 0.2s; }
    button:hover { background: #2980b9; }
    button:disabled { background: #bdc3c7; cursor: not-allowed; }
    .assigned-label { text-align: center; color: #7f8c8d; font-size: 13px; margin-top: -10px; margin-bottom: 15px; font-weight: bold; }
    .empty { text-align: center; color: #aaa; font-style: italic; }
  </style>
</head>
<body>

  <h1>Feature : 2. Key-Based Ordered Partitioning</h1>
  
  <div class="summary">
    <h2>Concept Summary</h2>
    <ul>
      <li><strong>The Lane Rule:</strong> Messages with the same Key (e.g., <code>India-vs-NewZealand</code>) will always hash to the same Partition.</li>
      <li><strong>The Hashing Rule:</strong> MurmurHash(key)%partitions</li>
      <li><strong>Order is Preserved:</strong> Because a match's events queue up in a single partition, they arrive at the consumer in strict chronological order.</li>
      <li><strong>Consumer Alignment:</strong> Kafka assigns exactly one partition to each consumer in the group, preventing two workers from reading the same match out of order.</li>
      <li><strong>Real-World Analogy:</strong> 2 Matches going on India vs NewZealand and Australia vs England, go ahead see what's happening on field</li>
    </ul>
  </div>

  <div style="margin-bottom: 20px; text-align: center;">
    <button id="produce-btn" onclick="produce()">Produce Match Event</button>
  </div>

  <h2>Kafka Topic (Brokers)</h2>
  <div id="partitions-view" class="row">
    <!-- Partitions injected here via JS -->
  </div>

  <h2>Consumers (Workers)</h2>
  <div id="consumers-view" class="row">
    <!-- Consumers injected here via JS -->
  </div>

  <script>
    // Note: Assuming your backend routes are updated for Phase 2 (e.g., /key-based-partitioning/api/...)
    async function produce() {
      await fetch('/keyed-ordered-partitioning/api/produce-message', { method: 'POST' });
      updateUI(); // Fetch immediately after producing for snappier feedback
    }

    async function updateUI() {
      const res = await fetch('/keyed-ordered-partitioning/api/fetch-state');
      const state = await res.json();

      // Update Producer Button State
      const btn = document.getElementById('produce-btn');
      if (state.eventCounter >= 6) {
        btn.disabled = true;
        btn.innerText = "Max Events Reached (6/6)";
      } else {
        btn.innerText = `Produce Match Event (${state.eventCounter}/6)`;
      }

      // 1. Draw the Partitions Row (2 Partitions)
      let pHTML = '';
      for (let i = 0; i < 2; i++) {
        // Assuming your backend sends 'm' as an object: { id: 1, matchName: "IND-vs-NZ", text: "Virat hits a six", time: "..." }
        let msgs = state.partitions[i].map(m => 
          `<div class="msg ${m.id === state.eventCounter ? 'highlight' : ''}">
             <strong>[${m.matchName}]</strong> ${m.text} 
             <small style="color: #888;">${m.time}</small>
           </div>`
        ).join('');
        
        pHTML += `<div class="box">
                    <h3>Partition ${i}</h3>
                    ${msgs || '<p class="empty">Waiting for events...</p>'}
                  </div>`;
      }
      document.getElementById('partitions-view').innerHTML = pHTML;

      // 2. Draw the Consumers Row (2 Consumers)
      let cHTML = '';
      for (let name of ["Consumer A", "Consumer B"]) {
        let data = state.consumers[name];
        
        let msgs = data.messages.map(m => 
          `<div class="msg ${m.id === state.eventCounter ? 'highlight' : ''}">
             <strong>[${m.matchName}]</strong> ${m.text}
             <small style="color: #888;">${m.time}</small>
           </div>`
        ).join('');
        
        cHTML += `<div class="box">
                    <h3>${name}</h3>
                    <p class="assigned-label">Assigned Partition: ${data.partition}</p>
                    ${msgs || '<p class="empty">Waiting for events...</p>'}
                  </div>`;
      }
      document.getElementById('consumers-view').innerHTML = cHTML;
    }

    // Refresh the UI every 2 seconds
    setInterval(updateUI, 2000);
    updateUI();
  </script>

</body>
</html>